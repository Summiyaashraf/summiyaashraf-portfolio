# Server-side only. The AI Portfolio Assistant reads these keys in
# src/app/api/chat/route.ts — never expose them with a NEXT_PUBLIC_ prefix.
# Copy this file to .env.local and fill in at least one key, otherwise the
# assistant falls back to its local (intent-matched) knowledge base.

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the chat model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# OpenAI — alternative provider, used when GEMINI_API_KEY is absent
OPENAI_API_KEY=
# Optional: override the chat model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
